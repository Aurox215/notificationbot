{
  "name": "aurox-job-monitor",
  "version": "0.8.2",
  "description": "Standalone Chrome extension for PeoplePerHour and Guru job alerts",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run extension:build",
    "extension:build": "node scripts/build-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p extension/tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "extension:package": "npm run extension:build && node scripts/package-extension.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15",
    "typescript": "^7.0.2"
  }
}
