{
  "name": "bidbot",
  "version": "1.0.0",
  "description": "Freelance job alerts from official emails to Telegram",
  "private": true,
  "main": "dist/src/cli/test-telegram.js",
  "scripts": {
    "start": "node dist/src/main.js",
    "dev": "npm run build && npm start",
    "demo": "npm run build && node dist/src/cli/demo.js",
    "health": "node dist/src/cli/health.js",
    "build": "tsc -p tsconfig.json && npm run extension:build",
    "extension:build": "node scripts/build-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p extension/tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "telegram:test": "npm run build && node dist/src/cli/test-telegram.js",
    "telegram:preview": "npm run build && node dist/src/cli/test-telegram.js --dry-run",
    "extension:package": "npm run extension:build && node scripts/package-extension.mjs",
    "extension:export-settings": "node scripts/export-extension-settings.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15",
    "typescript": "^7.0.2"
  }
}
