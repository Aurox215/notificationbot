# Copy to .env. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=15000

# Multi-user runtime: TELEGRAM_CHAT_ID is only used by the Phase 1 smoke test.
SOURCE_MODE=mock
# To use manual Chrome scans instead of mock projects, set SOURCE_MODE=extension.
# Pairing is disabled by default. The server always binds to 127.0.0.1.
INGESTION_ENABLED=false
INGESTION_PORT=4318
INGESTION_TOKEN=
MONITOR_INTERVAL_MS=5000
# Source retries occur across shared cycles, never once per user.
SOURCE_TIMEOUT_MS=15000
SOURCE_RETRY_BASE_MS=5000
SOURCE_RETRY_MAX_MS=300000
HEALTH_STALE_MS=60000
DATABASE_PATH=data/bidbot.sqlite
DEFAULT_KEYWORDS=AI,automation,Python,PHP,Laravel,React,Next.js,Node.js,TypeScript,WordPress,WooCommerce,Shopify,API,full-stack
