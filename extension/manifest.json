{
  "manifest_version": 3,
  "name": "Aurox Job Monitor",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "description": "Projects from your own visible Chrome pages, delivered only to your linked Telegram account.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:4318/*",
    "https://www.peopleperhour.com/*",
    "https://www.guru.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.peopleperhour.com/*",
        "https://www.guru.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4318"
  }
}
