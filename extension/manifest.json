{
  "manifest_version": 3,
  "name": "Aurox Job Monitor",
  "version": "0.7.6",
  "minimum_chrome_version": "120",
  "description": "Private standalone PeoplePerHour and Guru alerts through Aurox_notification_bot. No backend required.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "webRequest",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.telegram.org/*",
    "https://www.peopleperhour.com/*",
    "https://www.guru.com/*"
  ],
  "background": {
    "service_worker": "dist/standalone-background.js"
  },
  "action": {
    "default_popup": "standalone.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.peopleperhour.com/*",
        "https://www.guru.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://api.telegram.org"
  }
}
